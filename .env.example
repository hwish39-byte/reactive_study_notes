# Copy to .env and replace placeholders. Keep private keys in a Foundry keystore.
# These are separate networks. Confirm the RPCs and Omni proxy before deploying.
REACTIVE_RPC=
REACTIVE_CHAIN_ID=5318007
DESTINATION_RPC=
DESTINATION_CHAIN_ID=11155111

# Account names passed to forge --account, and the corresponding public signer addresses.
REACTIVE_ACCOUNT=
REACTIVE_DEPLOYER=0x0000000000000000000000000000000000000000
DESTINATION_ACCOUNT=
DESTINATION_DEPLOYER=0x0000000000000000000000000000000000000000
CLIENT_WALLET=0x0000000000000000000000000000000000000000

# Existing destination-chain contracts. No historical proxy/router addresses are assumed.
DESTINATION_CALLBACK_PROXY_ADDR=0x0000000000000000000000000000000000000000
ROUTER_ADDR=0x0000000000000000000000000000000000000000
PAIR_ADDR=0x0000000000000000000000000000000000000000

# Raw integer amounts in wei: 0.1 REACT and 0.02 destination native token.
REACTIVE_FUNDING_WEI=100000000000000000
CALLBACK_FUNDING_WEI=20000000000000000

# Single stop-loss parameters. Example assumes both tokens have 18 decimals.
SELL_TOKEN0=true
PRICE_COEFFICIENT=10000
STOP_LOSS_THRESHOLD=8000

# Fill each address only after the corresponding broadcast deployment succeeds.
SINGLE_REACTIVE_ADDR=0x0000000000000000000000000000000000000000
SINGLE_CALLBACK_ADDR=0x0000000000000000000000000000000000000000
MULTI_REACTIVE_ADDR=0x0000000000000000000000000000000000000000
MULTI_CALLBACK_ADDR=0x0000000000000000000000000000000000000000
