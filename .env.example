# 四个学习项目共用的环境变量模板；所有命令均从项目根目录执行。
# 已有 .env 时，请手动合并所需变量，不要覆盖已有私钥和部署地址。
# .env 保存真实配置，不提交 Git；本模板不填写真实私钥。
# 修改 .env 后，在终端依次执行：set -a; source .env; set +a
# 地址留空表示尚未填写，不能作为有效构造参数；成功广播后才记录部署地址。
# 同名变量只保留一项。部署地址按项目分别保存，避免覆盖其他项目的实例。

# ============================================================================
# 1. 公共网络与账户：两个 Uniswap demo 的部署脚本直接使用本组变量
# ============================================================================
# 示例链 ID：Reactive Lasna + Ethereum Sepolia；RPC、链 ID、proxy 必须匹配。
# foundry.toml 中 reactive / destination 两个 RPC 别名读取下面的 RPC 变量。
REACTIVE_RPC=
REACTIVE_CHAIN_ID=5318007
DESTINATION_RPC=
DESTINATION_CHAIN_ID=11155111

# Foundry keystore 账户名（--account）及其对应的公开地址（--sender）。
# 两个 Uniswap 部署脚本使用 keystore，不读取下方 starter 的 PRIVATE_KEY。
# 自编项目用 forge create 部署时，也可复用这些 RPC 和 keystore 账户。
REACTIVE_ACCOUNT=
REACTIVE_DEPLOYER=
DESTINATION_ACCOUNT=
DESTINATION_DEPLOYER=

# 代币持有人；同时是多订单 Callback 的 owner。
CLIENT_WALLET=

# 当前目标链的 Omni Callback Proxy，以及已有的 Uniswap V2 Router。
# 请填写实际环境的地址，不默认沿用上游示例中的历史地址。
DESTINATION_CALLBACK_PROXY_ADDR=
ROUTER_ADDR=

# 两个 Uniswap demo 共用的部署附带资金，单位均为 wei。
# 示例：0.1 Reactive 链原生币、0.02 目标链原生币；钱包另需部署 gas。
REACTIVE_FUNDING_WEI=100000000000000000
CALLBACK_FUNDING_WEI=20000000000000000

# ============================================================================
# 2. starter：script/DeployStarter.s.sol、script/verify-starter.sh
# ============================================================================
# 现有 starter 脚本直接读取私钥，仅在本地 .env 填写测试钱包私钥。
# 同一私钥用于各部署阶段，对应钱包在相关链上分别需要余额。
PRIVATE_KEY=

# starter 使用独立变量名，不能自动用 REACTIVE_RPC 等变量代替。
# 默认流程以 Sepolia 同时作为源链和目标链；核验脚本也共用此 Sepolia RPC。
# 若与上述公共网络一致，手动填写相同 RPC、目标链 ID 和 proxy 地址。
SEPOLIA_RPC_URL=
LASNA_RPC_URL=
ORIGIN_CHAIN_ID=11155111
DEST_CHAIN_ID=11155111
CALLBACK_PROXY=

# 与 starter 部署脚本的默认值一致；资金单位为 wei。
THRESHOLD=100
LIMIT=5
PING_VALUE=500
REACTIVE_FUND=500000000000000000
CALLBACK_FUND=20000000000000000

# 仅记录 starter 的部署结果：CampOrigin -> CampReactive -> CampCallback。
# 每部署成功一个合约，填回对应地址并重新导出，再执行下一阶段。
ORIGIN_ADDR=
REACTIVE_ADDR=
CALLBACK_ADDR=

# ============================================================================
# 3. 单笔止损：script/DeployStopOrder.s.sol
# ============================================================================
# Pair 必须位于 DESTINATION_CHAIN_ID 对应的链上，并已有流动性。
# 多订单建单时也可复用此 Pair，但其部署脚本不读取 PAIR_ADDR。
PAIR_ADDR=

# 示例假定两种代币精度相同：卖出 token0，储备价格 <= 0.8 时触发。
SELL_TOKEN0=true
PRICE_COEFFICIENT=10000
STOP_LOSS_THRESHOLD=8000

# 依次运行 deployReactive()、deployCallback()、configure()。
SINGLE_REACTIVE_ADDR=
SINGLE_CALLBACK_ADDR=

# ============================================================================
# 4. 多订单止损 / 止盈：script/DeployStopTakeProfit.s.sol
# ============================================================================
# 复用公共网络、账户、CLIENT_WALLET、proxy、Router 和部署附带资金。
# 每笔订单的 Pair、方向、数量、价格阈值及类型，通过 createStopOrder 传入。
# 依次运行 deployReactive()、deployCallback()、configure()。
MULTI_REACTIVE_ADDR=
MULTI_CALLBACK_ADDR=

# 注意：两个 Uniswap 子目录 README 的 forge create 示例使用通用
# REACTIVE_ADDR / CALLBACK_ADDR。共用本文件时，请改用对应 SINGLE_* / MULTI_*
# 变量执行这些直接部署命令；根目录部署脚本已使用项目专属名称。

# ============================================================================
# 5. 自编 transfer-monitor：StudyToken.sol、TransferMonitor.sol
# ============================================================================
# 当前没有配套部署脚本；下列变量供手动部署命令引用，不会被合约自动读取。
# StudyToken 无构造参数，在 Sepolia 部署后将其地址记录为 TRANSFER_TOKEN_ADDR。
# 可复用 DESTINATION_RPC / DESTINATION_ACCOUNT，但此处 RPC 必须是 Sepolia。
# TransferMonitor 在 Reactive 链部署，可复用 REACTIVE_RPC / REACTIVE_ACCOUNT。
# 其源链 ID 在源码中固定为 11155111，修改 .env 的链 ID 不会改变该常量。
# 无目标链回调，因此此项目不需要 Callback 合约或 callback proxy 配置。
TRANSFER_TOKEN_ADDR=

# TransferMonitor 的 --constructor-args 顺序：
# "$TRANSFER_TOKEN_ADDR" "$TRANSFER_MAX_COUNT"
# 部署时另传 --value "$TRANSFER_FUNDING_WEI"，资金必须大于零，单位 wei。
TRANSFER_MAX_COUNT=5
TRANSFER_FUNDING_WEI=100000000000000000

# TransferMonitor 成功广播后的地址，与各 demo 的 Reactive 地址分别保存。
TRANSFER_MONITOR_ADDR=
